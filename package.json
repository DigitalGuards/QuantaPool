{
  "name": "quantapool",
  "version": "0.1.0",
  "description": "Native QRL non-custodial pooled staking",
  "main": "index.js",
  "scripts": {
    "compile": "node scripts/compile-hyperion.js",
    "compile:hyperion": "node scripts/compile-hyperion.js",
    "test": "node scripts/test.js",
    "test:model": "node --test native/accounting-model.test.js",
    "test:tooling": "node --test scripts/*.test.js",
    "test:vm": "node native/testing/run.js",
    "test:proofs": "node native/proofs/run.js",
    "test:finality": "node native/finality/run.js"
  },
  "keywords": [
    "qrl",
    "pooled-staking",
    "post-quantum"
  ],
  "author": "DigitalGuards",
  "license": "GPL-3.0",
  "dependencies": {
    "@noble/hashes": "^2.3.0",
    "@theqrl/mldsa87": "^2.2.0",
    "@theqrl/qrl-cryptography": "^0.3.3",
    "@theqrl/wallet.js": "^6.3.0",
    "@theqrl/web3": "^1.0.3",
    "dotenv": "^17.4.2"
  },
  "overrides": {
    "@theqrl/mldsa87": "$@theqrl/mldsa87",
    "@theqrl/qrl-cryptography": "$@theqrl/qrl-cryptography",
    "@theqrl/wallet.js": "$@theqrl/wallet.js",
    "tmp": "^0.2.7",
    "follow-redirects": "^1.16.0",
    "ws": "^8.21.0"
  }
}
