# Copy to ignored .env.local for the intended fresh native deployment.
# Required: no RPC, chain ID or pool address is provided by default.
VITE_RPC_URL=
VITE_CHAIN_ID=
VITE_NATIVE_POOL_ADDRESS=

# Optional display and explorer settings.
VITE_NETWORK=TEST_NET
VITE_NETWORK_NAME=Native QRL pool
VITE_NETWORK_LABEL=Development
VITE_EXPLORER_URL=
VITE_DEPLOYMENT_BLOCK=0
